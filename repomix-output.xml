        profile, _ = Profile.objects.get_or_create(user=user) # tries to get the object, if not then it creates it
        return profile

    @staticmethod
    def update_profile(user: User, bio: str = None, website: str = None,profile_pic: str = None) -> Profile:
        profile = ProfileService.create_profile(user)

        if bio is not None:
            profile.bio = bio
        if website is not None:
            profile.website = website

        if profile_pic is not None:
            profile.profile_pic = profile_pic

        profile.save()
        return profile


class UserService:
    """Handles ONLY security, identity, and authentication logic."""

    @staticmethod
    def register_user(username: str, email: str, password: str) -> User:
        if User.objects.filter(username=username).exists():
            raise ValueError("This username is already taken.")
        if User.objects.filter(email=email).exists():
            raise ValueError("This email is already registered.")
        if len(password) < 8 or not any(char.isdigit() for char in password):
            raise ValueError("Password must be at least 8 characters long.")

        user = User.objects.create_user(username=username, email=email, password=password, is_active=False)
        return user

    @staticmethod
    def update_credentials(user: User, username: str = None, email: str = None):
        """Handles sensitive unique identifiers (Username & Email)."""

        # Check if they are trying to change the username, and if it's available
        if username and username != user.username:
            if User.objects.filter(username=username).exists():
                raise ValueError("This username is already taken.")
            user.username = username

        # Check if they are trying to change the email, and if it's available
        if email and email != user.email:
            if User.objects.filter(email=email).exists():
                raise ValueError("This email is already registered.")
            user.email = email

        # If anything changed, save it
        if username or email:
            user.save()

    # ... keep your update_password method right below this!


class AuthService:
    FRONTEND_URL = "http://localhost:5173"

    @staticmethod
    def login(username: str, password: str) -> dict:
        user = authenticate(username=username, password=password)
        if not user:
            raise ValueError("Invalid username or password.")

        refresh = RefreshToken.for_user(user)
        return {
            "username": user.username,
            "access_token": str(refresh.access_token),
            "refresh_token": str(refresh),
            "is_active": str(user.is_active)
        }

    @staticmethod
    def send_activation_email(user: User):
        uid = urlsafe_base64_encode(force_bytes(user.pk))
        token = default_token_generator.make_token(user)
        link = f"{AuthService.FRONTEND_URL}/activate/{uid}/{token}"

        send_mail(
            "Confirm your DOT8 Account",
            f"Hi {user.username},\nClick here to activate: {link}",
            settings.DEFAULT_FROM_EMAIL,
            [user.email],
        )

    @staticmethod
    def verify_email(uidb64: str, token: str):
        try:
            uid = force_str(urlsafe_base64_decode(uidb64))
            user = User.objects.get(pk=uid)
        except (TypeError, ValueError, OverflowError, User.DoesNotExist):
            raise ValueError("Invalid activation link.")

        if not default_token_generator.check_token(user, token):
            raise ValueError("Activation link is expired or invalid.")

        user.is_active = True
        user.save()

    @staticmethod
    def request_password_reset(email: str):
        try:
            user = User.objects.get(email=email)
            uid = urlsafe_base64_encode(force_bytes(user.pk))
            token = default_token_generator.make_token(user)
            link = f"{AuthService.FRONTEND_URL}/reset-password/{uid}/{token}"

            send_mail(
                "Reset your DOT8 Password",
                f"Click the link to reset your password:\n{link}",
                settings.DEFAULT_FROM_EMAIL,
                [user.email],
            )
        except User.DoesNotExist:
            pass # Silent fail for security

    @staticmethod
    def confirm_password_reset(uidb64: str, token: str, new_password: str):
        try:
            uid = force_str(urlsafe_base64_decode(uidb64))
            user = User.objects.get(pk=uid)
        except (TypeError, ValueError, OverflowError, User.DoesNotExist):
            raise ValueError("Invalid reset link.")

        if not default_token_generator.check_token(user, token):
            raise ValueError("Reset link is expired or invalid.")

        if len(new_password) < 8 or not any(char.isdigit() for char in new_password):
            raise ValueError("Password must be at least 8 characters long and contain a number.")

        user.set_password(new_password)
        user.save()
